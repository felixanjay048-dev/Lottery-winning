import tkinter as tk
from tkinter import Entry

def layar_klik(angka):
    posisi_sekarang = layar.get()
    layar.delete(0, tk.END)
    layar.insert(0, posisi_sekarang + str(angka))

def delete_klik():
    layar.delete(0, tk.END)

def tombol_samadengan():
    teks_layar = layar.get()
    if teks_layar != "":
        hasil = eval(teks_layar)
        layar.delete(0, tk.END)
        layar.insert(0, str(hasil))

windows = tk.Tk()
windows.title("Kalkulator")
windows.geometry("300x300")

layar = Entry(windows, font=("Arial", 16), justify="right")
layar.grid(row=0, column=0, columnspan=4, padx=10, pady=10)

tombol_data = [
    ('7', 1, 0), ('8', 1, 1), ('9', 1, 2), ('/', 1, 3),
    ('4', 2, 0), ('5', 2, 1), ('6', 2, 2), ('*', 2, 3),
    ('1', 3, 0), ('2', 3, 1), ('3', 3, 2), ('-', 3, 3),
    ('C', 4, 0), ('0', 4, 1), ('=', 4, 2), ('+', 4, 3)
]

for (teks, baris, kolom) in tombol_data:
    if teks.lower() == "c":
        aksi = delete_klik

    elif teks == "=":
        aksi = tombol_samadengan

    else:
        aksi = lambda text=teks: layar_klik(text)

    tk.Button(windows, text=teks, width=5, height=2, font=("Arial", 12), command=aksi).grid(row=baris, column=kolom, padx=5, pady=5)

windows.mainloop()
