import tkinter as tk

from tkinter import Canvas

windows = tk.Tk()

windows.geometry("400x400")

canva = Canvas(windows, width=400, height=400)

canva.create_rectangle(0, 0, 400, 130, fill="Black", outline="Black")

canva.create_rectangle(0, 130, 400, 260, fill="Red", outline="Red")

canva.create_rectangle(0, 261, 400, 600, fill="yellow", outline="yellow")

canva.pack()

windows.mainloop()
