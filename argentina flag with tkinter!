import tkinter as tk

from tkinter import Canvas

windows = tk.Tk()

windows.geometry('300x300')

canva = Canvas(windows, height=300, width=300)

canva.create_rectangle(0, 0, 1000, 100, fill='cyan', outline="cyan")

canva.create_rectangle(0, 200, 500, 300, fill="cyan", outline="cyan")

canva.create_oval(130, 130, 170, 170, fill="yellow", outline="yellow")

canva.pack()

canva.mainloop()
