import tkinter as tk 
from tkinter import Canvas

windows = tk.Tk()
windows.geometry("400x450")

canva = Canvas(windows, width=400, height=400)
canva.create_rectangle(200, 50, 700, 100, fill="blue", outline="blue")
canva.create_rectangle(200, 150, 750, 205, fill="blue", outline="blue")
canva.create_rectangle(0, 250, 400, 300, fill="blue", outline="blue")
canva.create_rectangle(0, 350, 400, 500, fill="blue", outline="blue")
canva.create_oval(50, 80, 140, 170, fill="yellow", outline="yellow")
canva.create_oval(20, 20, 50, 50, fill="")
canva.create_polygon(80, 80, 95, 50, 110, 80, fill="yellow", outline="yellow")     
canva.create_polygon(80, 170, 95, 200, 110, 170, fill="yellow", outline="yellow") 
canva.create_polygon(50, 110, 20, 125, 50, 140, fill="yellow", outline="yellow")
canva.create_polygon(140, 110, 170, 125, 140, 140, fill="yellow", outline="yellow")
canva.pack()

windows.mainloop()
