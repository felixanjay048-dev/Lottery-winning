import tkinter as tk

def klik(tombol):
    if tombol == "C":
        layar.delete(0, tk.END)
    elif tombol == "=":
        hasil = eval(layar.get())
        layar.delete(0, tk.END)
        layar.insert(tk.END, str(hasil))
    else:
        layar.insert(tk.END, tombol)


root = tk.Tk()
root.title("Kalkulator Simpel")

layar = tk.Entry(root, font=("Arial", 20), justify="right", bd=5)
layar.grid(row=0, column=0, columnspan=4, ipady=10, padx=5, pady=5)

tombol_list = [
    '7', '8', '9', '/',
    '4', '5', '6', '*',
    '1', '2', '3', '-',
    'C', '0', '=', '+'
]

baris, kolom = 1, 0
for teks in tombol_list:
    btn = tk.Button(root, text=teks, font=("Arial", 14), width=5, height=2, command=lambda t=teks: klik(t))
    btn.grid(row=baris, column=kolom, padx=2, pady=2)
    kolom += 1
    if kolom > 3:
        kolom = 0
        baris += 1

root.mainloop()
