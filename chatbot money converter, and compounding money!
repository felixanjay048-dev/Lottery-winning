def money_converter():

    while True:

        pilih = input("\nBasic: Pilih salah satu (Euro to IDR / USD to IDR / Keluar): ").lower()

        if pilih == "keluar":

            print("Basic: Terima kasih! Program selesai.")

            break

        if pilih == "euro to idr":

            convert = 20000

            euro = float(input("Basic: Berikan angka nominal uang Euro: "))

            file = euro * convert

            print(f"Basic: Ini adalah hasilnya: [{file}]")
            
        elif pilih == "usd to idr":

            convert = 17000

            usd = float(input("Basic: Berikan angka nominal uang USD: "))

            file = usd * convert

            print(f"Basic: Ini adalah hasilnya: [{file}]")
            
        else:

            print("Basic: Terjadi error, pilihan tidak valid. Silakan coba lagi!")


        ulang = input("Basic: Apakah ada yang ingin ditambahkan lagi? Ya / Tidak: ").lower()

