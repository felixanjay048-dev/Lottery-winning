                    bunga_didapat = modal * (bunga / 100) * (tahun / 365)

                    total_akhir = modal + bunga_didapat
                
                    print(f"Basic: Bunga yang didapat: [{round(bunga_didapat)}]")

                
            elif pilih == "rumus akhir":
                
                modal = int(input("Basic: Berikan modal awal: "))
                
