import tkinter as tk

from tkinter import Canvas, Label

windows = tk.Tk()

windows.geometry("400x400")

canva = Canvas(windows, width=400, height=400)

canva.create_rectangle(0, 190, 2000, 500, fill="red", outline="white")

canva.create_rectangle(0,0, 500, 190, fill="white", outline="white")

canva.create_rectangle(0, 0, 150, 190, fill="blue", outline="blue")

canva.pack()

flag = Label(windows, text="*", font=("Arial", 100), bg="blue", fg="white")

flag.place(x=40, y=30)


canva.pack()

windows.mainloop()
