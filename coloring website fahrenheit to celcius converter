import tkinter as tk 
from tkinter import Canvas, Button, Entry, Label 

def jendela_dekat():

    fahrenheit = int(entry_fahrenheit.get())
    celsius = (fahrenheit - 32) * 5/9

    label_hasil.config(text=f"{fahrenheit} Fahrenheit = {round(celsius)} Celcius")

windows = tk.Tk()
windows.geometry("500x500")

canva = Canvas(windows, width=500, height=500)
canva.create_rectangle(0, 0, 250, 500, fill="lightblue", outline="lightblue")
canva.create_rectangle(250, 0, 500, 500, fill="#DCAE96", outline="#DCAE96")
canva.create_rectangle(0, 250, 250, 500, fill="red", outline="red")
canva.create_rectangle(251, 250, 500, 500, fill="olive", outline="olive")
canva.pack()

label = Label(windows, text="Konversi Fahr", font=("Times New Roman", 16), bg="lightblue")
label.place(x=125, y=150)

label2 = Label(windows, text="enheit ke Celcius", font=("Times New Roman", 16), bg="#DCAE96")
label2.place(x=250, y=150)

entry_fahrenheit = Entry(windows)
entry_fahrenheit.place(x=190, y=180)

label_hasil = Label(windows, text='', font=("Times new Roman", 14), bg="silver", fg="black")
label_hasil.place(x=150, y=250)

button_konversi = Button(windows, text="Konversi", command=jendela_dekat)
button_konversi.place(x=223, y=210)

windows.mainloop()
