import tkinter as tk

from tkinter import Canvas, Label, Entry

windows = tk.Tk()

windows.geometry("400x400")

canva = Canvas(windows, width=400, height=400)

canva.create_rectangle(0, 0, 130, 100, fill="blue", outline="white")

canva.create_rectangle(250, 300, 1000, 600, fill="red", outline="white")

canva.pack()

label = Label(windows, text="Username", font=("Arial", 15))

label.place(x=150, y=100)

entry = Entry(windows)

entry.place(x=140, y=130)

label2 = Label(windows, text="Password", font=("Arial", 15))

label2.place(x=150, y=150)

entry2 = Entry(windows)

entry2.place(x=140, y=180)

canva.mainloop()
