import tkinter as tk 

from tkinter import Label, Entry, Button, Canvas

kurs = 18000

def calculate_converstion():

    usd = float(entry_usd.get())

    idr = usd * kurs

    label_result.config(text=f"IDR: {idr}")

window = tk.Tk()
window.geometry("400x400")

canvas = Canvas(window, width=400, height=400)
canvas.create_rectangle(0, 0, 400, 400, fill="lightblue")
canvas.pack()

label_title = tk.Label(window, text="USD to IDR Converter", font=("Times New Roman", 16, "bold"), bg="lightblue")
label_title.place(x=100, y=50)

tombol = Button(window, text="CONVERT", command=calculate_converstion)
tombol.place(x=165, y=110)

entry_usd = Entry(window)
entry_usd.place(x=140, y=80)

label_result = tk.Label(window, text="Rp 0", font=("Times New Roman", 14, "bold"), bg="lightblue")
label_result.place(x=140, y=140)

window.mainloop()
