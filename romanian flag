import tkinter as tk 
from tkinter import Canvas

windows = tk.Tk()
windows.geometry("400x400")

canva = Canvas(windows, height=400, width=400)
canva.create_rectangle(0, 0, 130, 400, fill="blue", outline="yellow")
canva.create_rectangle(130, 0, 280, 400, fill="yellow", outline="yellow")
canva.create_rectangle(260, 0, 410, 400, fill="red", outline="red")
canva.pack()

windows.mainloop()
